# ── Discord ───────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
# NEVER put real credentials in this file — it is committed to git.
# Copy this file to .env (gitignored) and fill the real values there.
DISCORD_TOKEN=your-bot-token-here
# Application (client) ID
DISCORD_CLIENT_ID=your-application-id-here
# Guild (server) ID — used for instant guild command deploy.
# Leave empty to deploy commands globally (can take up to 1h to appear).
DISCORD_GUILD_ID=
# Channel ID where signals are broadcast (fallback feed)
DISCORD_SIGNAL_CHANNEL_ID=

# Per-type broadcast channels — each signal type posts to its own channel.
DISCORD_HAKA_CHANNEL_ID=
DISCORD_BSJP_CHANNEL_ID=
DISCORD_SNIPER_CHANNEL_ID=
DISCORD_SWING_CHANNEL_ID=

# "Information done" channel — DONE announcements (with source + entry/done
# dates) are posted here when a signal reaches its +N% target.
DISCORD_DONE_CHANNEL_ID=

# Admin text flow: the channel analysts type signals in (e.g. "HAKA BBRI"),
# and the role allowed to create signals. The flow is disabled until the
# admin channel is set. Requires the privileged "Message Content" intent.
# The admin channel also receives operational alerts (tracker staleness).
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# Auto take-profit percentage above the average entry (default 3 => +3%).
SIGNAL_TP_PERCENT=3

# ── Telegram (optional, notification only) ────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database ──────────────────────────────────────────────
DATABASE_PATH=data/db.sqlite3

# ── Backend API (optional) ────────────────────────────────
API_PORT=3000

# ── Price Tracker (optional) ──────────────────────────────
# Price source: "mock" (no network, for dev) or "idx" (live quotes).
PRICE_SOURCE=mock
# Cron schedule for tracking passes (default: every minute).
TRACKER_CRON=* * * * *
# Quote endpoint template; "{ticker}" is replaced per request.
# Default targets Yahoo Finance chart API (IDX tickers use the .JK suffix).
IDX_API_URL=https://query1.finance.yahoo.com/v8/finance/chart/{ticker}.JK
# Pause between quote requests within a pass, in ms (rate-limit friendliness).
TRACKER_FETCH_DELAY_MS=250
# Only run passes during IDX trading sessions (Mon–Fri, WIB, skips lunch
# break and holidays from src/config/holidays.json). Defaults: on when
# PRICE_SOURCE=idx, off for mock. Set 0/1 to force.
TRACKER_MARKET_HOURS_ONLY=
# Send a Discord admin alert when no successful pass for N minutes while the
# market is open (0 = disabled), with a cooldown between repeat alerts.
TRACKER_STALE_ALERT_MIN=15
TRACKER_ALERT_COOLDOWN_MIN=60

# ── Trading Agents (optional, automated signal pipeline) ──
# Master switch: 1 to run the Market Scanner → Technical Analyst → Risk
# Manager → Portfolio Manager pipeline that creates & broadcasts signals
# automatically (HAKA PREOPEN, BSJP, SWING).
ENABLE_AGENTS=0
# Virtual capital (IDR) and allocation limits used by the Portfolio Manager.
AGENT_CAPITAL=100000000
AGENT_MAX_POSITION_PCT=5
AGENT_MAX_OPEN_POSITIONS=30
# Max signals created per run (per type per day).
AGENT_MAX_SIGNALS_PER_RUN=2
# Minimum technical score (0-100) to qualify as a candidate. Sengaja ketat
# (hanya setup A+); turunkan bila ingin lebih banyak sinyal.
AGENT_MIN_SCORE=85
# Market-regime gate: batalkan run saat IHSG di bawah EMA20 atau turun
# lebih dari AGENT_REGIME_MAX_DROP % hari itu.
AGENT_REGIME_FILTER=1
AGENT_REGIME_MAX_DROP=1
AGENT_INDEX_URL=https://query1.finance.yahoo.com/v8/finance/chart/%5EJKSE
# TP/SL percentages per type, measured from the entry AVG.
AGENT_TP_HAKA=3
AGENT_SL_HAKA=10
AGENT_TP_BSJP=3
AGENT_SL_BSJP=10
AGENT_TP_SWING=10
AGENT_SL_SWING=30
# Schedules (WIB). Scan runs before open; each type runs at its moment.
AGENT_SCAN_CRON=15 7 * * 1-5
AGENT_HAKA_CRON=47 8 * * 1-5
AGENT_BSJP_CRON=25 15 * * 1-5
AGENT_SWING_CRON=15 16 * * 1-5
AGENT_RECAP_CRON=0 17 * * 1-5
# Market Scanner filters.
AGENT_UNIVERSE_PATH=src/config/idx-tickers.json
AGENT_HISTORY_RANGE=3mo
AGENT_MIN_PRICE=60
AGENT_MIN_VALUE=1000000000
AGENT_VOLUME_SPIKE=1.5
AGENT_FETCH_DELAY_MS=300

# ── Logging ───────────────────────────────────────────────
# debug | info | warn | error. JSON-lines files land in logs/<service>.log;
# error-level entries are also persisted to the `errors` table.
LOG_LEVEL=info

# ── Timezone ──────────────────────────────────────────────
TZ=Asia/Jakarta
